{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pianic2/personal-library-react-native-components/ai/schema/props.schema.json",
  "title": "Props manifest",
  "description": "Machine-readable props contract of the public components (generated by scripts/ai/build-props.mjs, never edited by hand).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "version", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["props"],
      "properties": {
        "status": { "enum": ["prototype", "demo", "stable", "production-ready", "deprecated"] },
        "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "default", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "default": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] },
        "defaultExpression": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
        }
      }
    }
  }
}
