{
  "name": "@personal-library/react-native-components",
  "version": "0.1.0-rc.2",
  "description": "Personal Library React Native Components.",
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "typescript",
    "accessibility"
  ],
  "homepage": "https://github.com/pianic2/personal-library-react-native-components#readme",
  "bugs": {
    "url": "https://github.com/pianic2/personal-library-react-native-components/issues"
  },
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pianic2/personal-library-react-native-components.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "theme": [
        "dist/theme/index.d.ts"
      ],
      "tokens": [
        "dist/tokens/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme/index.js",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "react-native": "./dist/tokens/index.js",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "rc"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc -p tsconfig.type-tests.json --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --experimental-loader ./tests/react-native-loader.mjs --test tests/**/*.test.tsx && npm run test:native",
    "test:native": "node --import tsx --import ./tests/setup.ts --experimental-loader ./tests/react-native-loader.mjs --test tests/native/**/*.test.tsx",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "npm run clean && npm run typecheck && npm run build",
    "package:dry-run": "npm pack --dry-run",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "consumer:expo": "node scripts/expo-consumer-smoke.mjs",
    "docs:compat": "node scripts/compatibility-docs.mjs",
    "docs:compat:check": "node scripts/compatibility-docs.mjs --check",
    "api:snapshot": "node scripts/public-api-snapshot.mjs",
    "api:snapshot:check": "node scripts/public-api-snapshot.mjs --check",
    "ai:build:props": "node scripts/ai/build-props.mjs",
    "clean": "rm -rf dist *.tgz",
    "release:guard": "node scripts/release-guard.mjs",
    "release:security": "node scripts/audit-gate.mjs",
    "prepack": "npm run build:prod && npm run release:guard",
    "prepack:check": "npm run build:prod && npm run release:guard && npm run package:dry-run",
    "release:check": "npm run clean && npm ci && npm run release:guard && npm run docs:compat:check && npm run api:snapshot:check && npm run typecheck && npm run typecheck:contracts && npm test && npm run build && npm run package:dry-run && npm run consumer:smoke && npm run consumer:expo && npm run release:security"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <20.0.0",
    "react-native": ">=0.86.0 <0.87.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.20.0",
    "react-test-renderer": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0"
  }
}
