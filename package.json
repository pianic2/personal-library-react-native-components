{
  "name": "@personal-library/react-native-components",
  "version": "0.1.0-rc.2",
  "description": "Personal Library React Native Components.",
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "typescript",
    "accessibility"
  ],
  "homepage": "https://github.com/pianic2/personal-library-react-native-components#readme",
  "bugs": {
    "url": "https://github.com/pianic2/personal-library-react-native-components/issues"
  },
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pianic2/personal-library-react-native-components.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "theme": [
        "dist/theme/index.d.ts"
      ],
      "tokens": [
        "dist/tokens/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme/index.js",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "react-native": "./dist/tokens/index.js",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "rc"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc -p tsconfig.type-tests.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --experimental-loader ./tests/react-native-loader.mjs --test \"tests/**/*.test.{ts,tsx}\"",
    "test:coverage": "node --import tsx --import ./tests/setup.ts --experimental-loader ./tests/react-native-loader.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**/*\" --test-coverage-lines=90 --test-coverage-branches=86 --test-coverage-functions=92 \"tests/**/*.test.{ts,tsx}\"",
    "test:native": "node --import tsx --import ./tests/setup.ts --experimental-loader ./tests/react-native-loader.mjs --test \"tests/native/**/*.test.{ts,tsx}\"",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "npm run clean && npm run typecheck && npm run build && npm run ai:build",
    "package:dry-run": "npm pack --dry-run",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "consumer:expo": "node scripts/expo-consumer-smoke.mjs",
    "docs:compat": "node scripts/compatibility-docs.mjs",
    "docs:compat:check": "node scripts/compatibility-docs.mjs --check",
    "api:snapshot": "node scripts/public-api-snapshot.mjs",
    "api:snapshot:check": "node scripts/public-api-snapshot.mjs --check",
    "maturity:check": "node scripts/maturity-check.mjs",
    "maturity:docs": "node scripts/gen-maturity-docs.mjs",
    "maturity:docs:check": "node scripts/gen-maturity-docs.mjs --check",
    "tokens:check": "node scripts/check-token-usage.mjs",
    "ai:build:props": "node scripts/ai/build-props.mjs",
    "ai:build": "node -e \"const fs=require('fs');fs.mkdirSync('dist/meta',{recursive:true});for(const f of fs.readdirSync('ai/manifests').filter(f=>f.endsWith('.json')))fs.copyFileSync('ai/manifests/'+f,'dist/meta/'+f)\"",
    "ai:check": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const bad=(p.files||[]).filter(f=>/^(skills|AGENTS|llms)/.test(f));if(bad.length||!fs.readdirSync('ai/manifests').some(f=>f.endsWith('.json'))){console.error('ai:check failed',bad);process.exit(1)}\"",
    "size": "node scripts/bundle-size.mjs --check",
    "size:report": "node scripts/bundle-size.mjs",
    "size:treeshake": "node scripts/treeshake-check.mjs",
    "clean": "rm -rf dist *.tgz",
    "release:guard": "node scripts/release-guard.mjs",
    "release:security": "node scripts/audit-gate.mjs",
    "prepack": "npm run build:prod && npm run release:guard",
    "prepack:check": "npm run build:prod && npm run release:guard && npm run package:dry-run",
    "release:check": "npm run clean && npm ci && npm run release:guard && npm run docs:compat:check && npm run api:snapshot:check && npm run typecheck && npm run typecheck:contracts && npm run typecheck:tests && npm run maturity:check && npm run maturity:docs:check && npm run tokens:check && npm test && npm run build && npm run package:dry-run && npm run consumer:smoke && npm run consumer:expo && npm run release:security"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <20.0.0",
    "react-native": ">=0.86.0 <0.87.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.20.0",
    "react-test-renderer": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0"
  }
}
